      "statusCode": 301
    },
    {
      "source": "/fr/geo-audit",
      "destination": "/fr/webdesign#ki-sichtbarkeit",
      "statusCode": 301
    },
    {
      "source": "/fr/geo-audit/",
      "destination": "/fr/webdesign#ki-sichtbarkeit",
      "statusCode": 301
    },
    {
      "source": "/en/geo-audit",
      "destination": "/en/webdesign#ki-sichtbarkeit",
      "statusCode": 301
    },
    {
      "source": "/en/geo-audit/",
      "destination": "/en/webdesign#ki-sichtbarkeit",
